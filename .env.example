ELEVENLABS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used only after repeated HTTP 503. Leave blank to disable model fallback.
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
JISR_HOST=127.0.0.1
JISR_PORT=8766
JISR_MAX_UPLOAD_MB=250
JISR_TRUST_PROXY=0
JISR_DOMAIN=
