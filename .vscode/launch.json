{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Jisr: backend + frontend (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "jinja": false
    }
  ]
}
