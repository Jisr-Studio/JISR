{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "JISR: Run app",
      "type": "process",
      "command": "python3",
      "args": [
        "server.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "JISR: Run tests",
      "type": "process",
      "command": "python3",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "JISR: Check public sources",
      "type": "process",
      "command": "python3",
      "args": [
        "scripts/check_sources.py",
        "--output",
        "docs/source-check.json"
      ],
      "problemMatcher": []
    }
  ]
}
